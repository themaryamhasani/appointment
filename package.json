{
  "name": "healthcare-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant healthcare appointment and clinic management platform",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @healthcare/api dev",
    "dev:web": "pnpm --filter @healthcare/web dev",
    "dev:worker": "pnpm --filter @healthcare/api worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @healthcare/api test:e2e",
    "db:generate": "pnpm --filter @healthcare/api prisma:generate",
    "db:migrate": "pnpm --filter @healthcare/api prisma:migrate",
    "db:seed": "pnpm --filter @healthcare/api prisma:seed",
    "db:studio": "pnpm --filter @healthcare/api prisma:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "15.5.27",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
