# Application
NODE_ENV=development
APP_NAME=Healthcare Platform
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/healthcare?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# Use memory store only when Redis is unavailable and explicitly allowed
REDIS_FALLBACK=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Slot Reservation
SLOT_RESERVATION_TTL_SECONDS=300

# Payment — mock (CI/local) or zarinpal
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_CALLBACK_URL=http://localhost:4000/api/v1/payments/callback
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Notifications / Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@healthcare.local

# SMS — mock or kavenegar
SMS_PROVIDER=mock
SMS_API_KEY=
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Reminders (hours before appointment)
REMINDER_HOURS_24=24
REMINDER_HOURS_2=2

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Seed
SEED_PASSWORD=Demo@123456

# Logging
LOG_LEVEL=info
